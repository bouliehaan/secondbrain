# Wait briefly for the NVIDIA output to appear, then enable it.
for i in $(seq 1 15); do
    xrandr --output HDMI-1-0 \
        --mode 1920x1080 \
        --rate 60 \
        --primary &&
        break

    sleep 1
done

xset s off
xset -dpms
xset s noblank

unclutter -idle 0.5 -root &
/usr/local/bin/calendar-kiosk &

# BEGIN MAGICMIRROR NATIVE CLOCK
/usr/local/bin/magicmirror-native-clock-launcher &
# END MAGICMIRROR NATIVE CLOCK
