:root {
  --color-text: #d8dee7;
  --color-text-dimmed: #8994a2;
  --color-text-bright: #ffffff;
  --color-background: #070a0f;

  --font-size: 18px;

  --gap-body-top: 0;
  --gap-body-right: 0;
  --gap-body-bottom: 0;
  --gap-body-left: 0;

  --gap-modules: 0;
}

* {
  box-sizing: border-box;
}

html,
body {
  width: 100%;
  height: 100%;

  margin: 0;
  overflow: hidden;

  background: #070a0f;
}

/******************************************************************************
 * PRIMARY TWO-COLUMN LAYOUT
 *
 * Calendar:
 *   left:   18px
 *   right:  474px
 *
 * Sidebar:
 *   width:  420px
 ******************************************************************************/

.region.bottom.bar {
  top: 18px;
  right: 474px;
  bottom: 18px;
  left: 18px;

  width: auto;
  height: auto;
}

.region.bottom.bar .container,
.region.bottom.bar .module.main-month-calendar,
.main-month-calendar .module-content,
.main-month-calendar .CX3 {
  width: 100%;
  height: 100%;
}

.region.top.right {
  top: 18px;
  right: 20px;
  bottom: 18px;

  width: 420px;
  height: auto;
  max-height: none;

  padding-left: 20px;

  overflow: hidden;
  text-align: left;

  border-left: 1px solid rgba(255, 255, 255, 0.16);
}

.region.top.right .container {
  display: flex;
  flex-direction: column;
  align-items: stretch;

  width: 100%;
  height: 100%;
}

.region.top.right .module {
  flex: 0 0 auto;

  width: 100%;
  margin: 0 0 13px;
}

.region.top.right .module:last-child {
  margin-bottom: 0;
}

/******************************************************************************
 * CLOCK
 ******************************************************************************/

.side-clock {
  text-align: right;
}

.side-clock .time {
  font-size: 62px;
  font-weight: 300;
  line-height: 0.95;
  letter-spacing: -2px;

  color: #ffffff;
}

.side-clock .date {
  margin-top: 7px;

  font-size: 20px;
  line-height: 1.15;

  color: #aab5c1;
}

/******************************************************************************
 * WEATHER
 ******************************************************************************/

.region.top.right header {
  margin-bottom: 6px;
  padding-bottom: 5px;

  font-size: 14px;
  font-weight: 700;
  letter-spacing: 1.4px;

  color: #cbd5df;
  border-bottom: 1px solid rgba(255, 255, 255, 0.15);
}

.side-current-weather {
  text-align: right;
}

.side-current-weather .large {
  font-size: 48px;
  line-height: 1;
}

.side-current-weather .normal,
.side-current-weather .small {
  font-size: 16px;
}

.side-forecast table {
  width: 100%;
  font-size: 16px;
}

.side-forecast table td {
  padding-top: 2px;
  padding-bottom: 2px;
}

/******************************************************************************
 * MONTH CALENDAR
 ******************************************************************************/

/*
 * CalendarExt3 uses .weekGrid for several different elements.
 * Never assign a general height to .weekGrid.
 */
.CX3 .headerContainer {
  height: 28px;
  margin-bottom: 4px;
  line-height: 28px;
}


.CX3 {
  --celllinecolor: rgba(255, 255, 255, 0.15);
  --cellbgcolor: rgba(255, 255, 255, 0.025);

  --cellheaderheight: 28px;
  --cellfooterheight: 2px;

  --defaultcolor: #f4f7fa;

  width: 100%;
  height: 100%;
}

.CX3 .headerTitle {
  height: 44px;
  margin: 0;
  padding: 0 0 8px;

  font-size: 30px;
  font-weight: 500;
  line-height: 36px;
  text-align: left;
  letter-spacing: -0.5px;

  color: #ffffff;
}
.CX3 .week {
  padding: 0 2px;
}

.CX3 .cell {
  background-color: rgba(255, 255, 255, 0.022);
}

.CX3 .cell.thisMonth {
  background-color: rgba(255, 255, 255, 0.055);
}

.CX3 .cellHeader {
  font-weight: 600;
}

.CX3 .cell.today {
  border-color: #ffffff;
  box-shadow: inset 0 0 0 2px #ffffff;
}

.CX3 .today .cellDate {
  padding: 1px 7px;
  border-radius: 12px;

  color: #070a0f;
  background: #ffffff;
}

.CX3 .weekend,
.CX3 .weekend_1,
.CX3 .weekend_2 {
  color: #b7c2ce;
}

.CX3 .event {
  border-radius: 4px;
}

.CX3 .event .title {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/******************************************************************************
 * UPCOMING AGENDA
 ******************************************************************************/

.module.side-agenda {
  flex: 1 1 auto;

  min-height: 0;
  overflow: hidden;
}

.side-agenda .module-content {
  height: calc(100% - 28px);
  overflow: hidden;
}

.CX3A {
  width: 100%;
  height: 100%;

  font-size: 15px;
  line-height: 1.2;
  text-align: left;
}

.CX3A .miniMonth {
  display: none !important;
}

.CX3A .agenda {
  height: 100%;
  overflow: hidden;
}

.CX3A .cell {
  margin: 0 0 10px;
}

.CX3A .cellHeader {
  margin-bottom: 4px;
  padding-bottom: 3px;

  border-bottom: 1px solid rgba(255, 255, 255, 0.11);
}

.CX3A .cellHeaderMain {
  display: flex;
  align-items: baseline;
  gap: 7px;
}

.CX3A .cellDay,
.CX3A .cellDate,
.CX3A .relativeDay {
  font-size: 14px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.5px;

  color: #aeb9c5;
}

.CX3A .cell.today .cellDay,
.CX3A .cell.today .cellDate,
.CX3A .cell.today .relativeDay {
  color: #ffffff;
}

.CX3A .event {
  margin: 4px 0;
  padding: 5px 7px;

  overflow: hidden;

  border-left: 4px solid #7f8b99;
  border-radius: 4px;

  background: rgba(255, 255, 255, 0.055);
}

.CX3A .event .headline {
  display: flex;
  align-items: baseline;
  gap: 8px;
}

.CX3A .event .symbol {
  display: none;
}

.CX3A .event .time {
  flex: 0 0 68px;

  font-size: 13px;
  font-weight: 600;
  white-space: nowrap;

  color: #adb8c4;
}

.CX3A .event .title {
  flex: 1 1 auto;

  overflow: hidden;

  font-size: 15px;
  font-weight: 500;
  line-height: 1.15;

  white-space: normal;
  text-overflow: ellipsis;

  color: #f4f7fa;
}

.CX3A .event .description,
.CX3A .event .location,
.CX3A .event .endTime {
  display: none;
}

/******************************************************************************
 * SHARED CALENDAR COLORS
 ******************************************************************************/

/* Personal */
.CX3 .calendar_personal,
.CX3A .calendar_personal {
  color: #ffffff;
  background: rgba(78, 161, 255, 0.26);
  border-left-color: #4EA1FF;
}

/* Holidays */
.CX3 .calendar_holidays,
.CX3A .calendar_holidays {
  color: #ffffff;
  background: rgba(255, 93, 115, 0.25);
  border-left-color: #FF5D73;
}

/* UFC */
.CX3 .calendar_ufc,
.CX3A .calendar_ufc {
  color: #ffffff;
  background: rgba(255, 184, 77, 0.25);
  border-left-color: #FFB84D;
}

/* Appointments */
.CX3 .calendar_appointments,
.CX3A .calendar_appointments {
  color: #ffffff;
  background: rgba(168, 121, 255, 0.26);
  border-left-color: #A879FF;
}
