/* BEGIN CALENDAR LIVE HEADER PATCH */

/******************************************************************************
 * REMOVE THE UNUSED OUTER CALENDAREXT3 HEADER
 *
 * The real month heading is .CX3 > .headerTitle.
 ******************************************************************************/

.region.bottom.bar
.module.MMM-CalendarExt3
> header:empty {
  display: none !important;
}

/******************************************************************************
 * DYNAMIC TEXT INSIDE THE REAL MONTH HEADER
 *
 * Absolute positioning means the status occupies the existing header row and
 * does not increase its height or move the calendar downward.
 ******************************************************************************/

.region.bottom.bar
.module.MMM-CalendarExt3
.CX3
> .headerTitle.calendar-live-header-host {
  position: relative !important;

  display: block !important;

  box-sizing: border-box;

  width: 100% !important;

  padding-right: 46% !important;
}

.calendar-live-status {
  position: absolute;

  top: 50%;
  right: 6px;

  display: block;

  width: 44%;
  max-width: 44%;

  margin: 0;
  padding: 0;

  overflow: hidden;

  transform: translateY(-50%);

  border: 0 !important;
  border-radius: 0 !important;

  background: transparent !important;
  box-shadow: none !important;

  color:
    var(
      --calm-muted,
      #626b69
    ) !important;

  font-size: 15px !important;
  font-weight: 500 !important;
  line-height: 1.2 !important;
  letter-spacing: 0 !important;

  text-align: right;

  white-space: nowrap;
  text-overflow: ellipsis;
}

html.solar-dark
.calendar-live-status {
  color:
    var(
      --calm-muted,
      #aab1af
    ) !important;
}

