# Dependencies
node_modules/
npm-debug.log*
yarn-error.log*

# Real credentials. Only *.example.json templates belong in the repo.
# Live secrets live on the mirror at /etc/magicmirror-secondbrain/
config/secondbrain/**/*.json
!config/secondbrain/**/*.example.json

# Runtime state written by the module on the mirror
package_state.json

# Build output. packaging/build-deb.sh stages into build/ and writes the
# package to dist/; neither belongs in the repo.
build/
dist/

# Logs and captures
*.log
logs/
screenshot/

# Python
__pycache__/
*.py[cod]

# Editor / OS
.DS_Store
._*
.Spotlight-V100
.Trashes
Thumbs.db
*.swp

# Ad-hoc rescue copies. Git history is the version control now.
*.before-*
*.bak
*.orig

# Maintainer tooling: deploy.sh ships a worktree to my dev boxes, commit.sh is
# the gate before anything goes public. They live on my machine, not in the
# repo — nobody cloning this can use them.
#
# Named individually rather than as *.sh. The blanket rule also swallowed every
# legitimate shell script in the repo: a new one would be untracked from the
# moment it was written, `git status` would stay clean, and nobody would notice
# until it went missing. Packaging needs real scripts, so the rule names its six
# targets instead.
/commit.sh
/deploy.sh
/scripts/bootstrap.sh
/scripts/check-calendars.sh
/scripts/deploy.sh
/scripts/enable-nowplaying.sh
/scripts/pull-from-pi.sh
/scripts/restore-calendar-urls.sh
