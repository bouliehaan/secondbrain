# Dependencies
node_modules/
npm-debug.log*
yarn-error.log*

# Real credentials. Only *.example.json templates belong in the repo.
# Live secrets live on the mirror at /etc/magicmirror-secondbrain/
config/secondbrain/**/*.json
!config/secondbrain/**/*.example.json

# Runtime state written by the module on the mirror
package_state.json

# Logs and captures
*.log
logs/
screenshot/

# Python
__pycache__/
*.py[cod]

# Editor / OS
.DS_Store
._*
.Spotlight-V100
.Trashes
Thumbs.db
*.swp

# Ad-hoc rescue copies. Git history is the version control now.
*.before-*
*.bak
*.orig

# Maintainer tooling: deploy.sh ships a worktree to my dev boxes, commit.sh is
# the gate before anything goes public. They live on my machine, not in the
# repo — nobody cloning this can use them.
*.sh
