#!/usr/bin/env bash
set -u

export TZ="America/Denver"

URL="http://127.0.0.1:43761"
PROFILE="$HOME/snap/chromium/common/magicmirror-kiosk-chrony"

chrony_is_ready() {
    local tracking reference leap offset

    tracking="$(/usr/bin/chronyc tracking 2>/dev/null)" ||
        return 1

    leap="$(
        printf '%s\n' "$tracking" |
        awk -F: '
            /^Leap status/ {
                gsub(/^[[:space:]]+|[[:space:]]+$/, "", $2)
                print $2
            }
        '
    )"

    [[ "$leap" == "Normal" ]] ||
        return 1

    reference="$(
        printf '%s\n' "$tracking" |
        awk -F: '
            /^Reference ID/ {
                gsub(/^[[:space:]]+|[[:space:]]+$/, "", $2)
                split($2, parts, /[[:space:]]+/)
                print parts[1]
            }
        '
    )"

    [[ -n "$reference" ]] ||
        return 1

    [[ "$reference" != "00000000" ]] ||
        return 1

    [[ "$reference" != "0.0.0.0" ]] ||
        return 1

    offset="$(
        printf '%s\n' "$tracking" |
        awk -F: '
            /^System time/ {
                gsub(/^[[:space:]]+|[[:space:]]+$/, "", $2)
                split($2, parts, /[[:space:]]+/)
                print parts[1]
            }
        '
    )"

    [[ -n "$offset" ]] ||
        return 1

    awk -v value="$offset" '
        BEGIN {
            if (value < 0) {
                value = -value
            }

            exit !(value <= 0.010)
        }
    '
}

while true; do
[[:space:]]*#
[[:space:]]*# Chromium is not allowed to start until the Linux clock is
[[:space:]]*# synchronized by Chrony and within 10 ms of its reference.
[[:space:]]*#/
    until chrony_is_ready; do
        sleep 1
    done

    until curl \
        -fsS \
        --max-time 3 \
        "$URL" \
        >/dev/null
    do
        sleep 1
    done

    mkdir -p "$PROFILE"
    rm -f "$PROFILE"/Singleton*

    SESSION_URL="${URL}/?kiosk_session=$(date +%s%N)"

    /snap/bin/chromium \
        --user-data-dir="$PROFILE" \
        --kiosk \
        --app="$SESSION_URL" \
        --no-first-run \
        --no-default-browser-check \
        --noerrdialogs \
        --disable-session-crashed-bubble \
        --disable-background-timer-throttling \
        --disable-renderer-backgrounding \
        --disable-backgrounding-occluded-windows \
        --disable-application-cache \
        --disk-cache-size=1 \
        --media-cache-size=1 \
        --disable-features=Translate,TranslateUI,CalculateNativeWinOcclusion \
        --disable-pinch \
        --overscroll-history-navigation=0 \
        --password-store=basic

    sleep 3
done
