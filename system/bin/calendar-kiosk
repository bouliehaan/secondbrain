#!/usr/bin/env bash
set -u

# Settings come from the package's defaults file when there is one, so the
# timezone and the browser are not baked into this script. The fallbacks are
# what this wall has always used, so an unconfigured box behaves as before.
if [[ -r /etc/default/secondbrain ]]; then
    set -a
    source /etc/default/secondbrain
    set +a
fi

# The kiosk's own timezone. The box itself is Etc/UTC; this is what the wall
# reads in, and what check-calendars.js reports event times against.
export TZ="${SECONDBRAIN_TZ:-America/Denver}"

URL="http://127.0.0.1:${SECONDBRAIN_PORT:-43761}"
PROFILE="$HOME/snap/chromium/common/magicmirror-kiosk-chrony"

# This box's chromium is a snap, so the snap path is tried first. Falling back
# to PATH is what lets the package install on a box where it is a deb.
resolve_chromium() {
    local candidate

    if [[ -n "${SECONDBRAIN_CHROMIUM:-}" ]]; then
        printf '%s\n' "$SECONDBRAIN_CHROMIUM"
        return 0
    fi

    for candidate in /snap/bin/chromium chromium chromium-browser; do
        if command -v "$candidate" >/dev/null 2>&1; then
            command -v "$candidate"
            return 0
        fi
    done

    return 1
}

if ! CHROMIUM="$(resolve_chromium)"; then
    echo "calendar-kiosk: no chromium found." >&2
    echo "Set SECONDBRAIN_CHROMIUM in /etc/default/secondbrain." >&2
    exit 1
fi

chrony_is_ready() {
    local tracking reference leap offset

    tracking="$(/usr/bin/chronyc tracking 2>/dev/null)" ||
        return 1

    leap="$(
        printf '%s\n' "$tracking" |
        awk -F: '
            /^Leap status/ {
                gsub(/^[[:space:]]+|[[:space:]]+$/, "", $2)
                print $2
            }
        '
    )"

    [[ "$leap" == "Normal" ]] ||
        return 1

    reference="$(
        printf '%s\n' "$tracking" |
        awk -F: '
            /^Reference ID/ {
                gsub(/^[[:space:]]+|[[:space:]]+$/, "", $2)
                split($2, parts, /[[:space:]]+/)
                print parts[1]
            }
        '
    )"

    [[ -n "$reference" ]] ||
        return 1

    [[ "$reference" != "00000000" ]] ||
        return 1

    [[ "$reference" != "0.0.0.0" ]] ||
        return 1

    offset="$(
        printf '%s\n' "$tracking" |
        awk -F: '
            /^System time/ {
                gsub(/^[[:space:]]+|[[:space:]]+$/, "", $2)
                split($2, parts, /[[:space:]]+/)
                print parts[1]
            }
        '
    )"

    [[ -n "$offset" ]] ||
        return 1

    awk -v value="$offset" '
        BEGIN {
            if (value < 0) {
                value = -value
            }

            exit !(value <= 0.010)
        }
    '
}

while true; do
    #
    # Chromium is not allowed to start until the Linux clock is
    # synchronized by Chrony and within 10 ms of its reference.
    #
    until chrony_is_ready; do
        sleep 1
    done

    until curl \
        -fsS \
        --max-time 3 \
        "$URL" \
        >/dev/null
    do
        sleep 1
    done

    mkdir -p "$PROFILE"
    rm -f "$PROFILE"/Singleton*

    SESSION_URL="${URL}/?kiosk_session=$(date +%s%N)"

    "$CHROMIUM" \
        --user-data-dir="$PROFILE" \
        --kiosk \
        --app="$SESSION_URL" \
        --no-first-run \
        --no-default-browser-check \
        --noerrdialogs \
        --disable-session-crashed-bubble \
        --disable-background-timer-throttling \
        --disable-renderer-backgrounding \
        --disable-backgrounding-occluded-windows \
        --disable-application-cache \
        --disk-cache-size=1 \
        --media-cache-size=1 \
        --disable-features=Translate,TranslateUI,CalculateNativeWinOcclusion \
        --disable-pinch \
        --overscroll-history-navigation=0 \
        --password-store=basic

    sleep 3
done
