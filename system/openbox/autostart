# The wall's monitor, on whichever output it is plugged into: the first one
# xrandr reports connected. Naming the output broke when the NVIDIA card came
# out -- and xrandr exits 0 on an output it cannot find, so it never retried.
# Waits up to fifteen seconds for an output to show up.
for i in $(seq 1 15); do
    output="$(xrandr --query | awk '$2 == "connected" { print $1; exit }')"

    if [ -n "$output" ] &&
        xrandr --output "$output" \
            --mode 1920x1080 \
            --rate 60 \
            --primary; then
        break
    fi

    sleep 1
done

xset s off
xset -dpms
xset s noblank

# openbox-autostart runs this file with sh, not bash: POSIX only.

# The clock is a transparent window, and only a compositor makes it one;
# without picom X paints it as a black box over the page. picom 12 (Ubuntu
# 26.04) refuses to start without a backend named, where 11 defaulted to
# xrender, so name it.
picom -b --backend xrender &
unclutter -idle 0.5 -root &

# The .deb installs these under /usr/bin, scripts/deploy.sh under
# /usr/local/bin. Start whichever this box has, the hand-deployed one first.
start_installed() {
    for dir in /usr/local/bin /usr/bin; do
        if [ -x "$dir/$1" ]; then
            "$dir/$1" &
            return 0
        fi
    done
    echo "autostart: $1 is not installed" >&2
}

start_installed calendar-kiosk

