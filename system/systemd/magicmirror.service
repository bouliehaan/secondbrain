[Unit]
Description=MagicMirror wall dashboard
Documentation=https://github.com/bouliehaan/secondbrain

Wants=network-online.target
After=network-online.target

# This box orders the dashboard after two local units -- a tunnel and a VPN.
# Both names are specific to this machine, and neither is committed: the repo
# was sanitised once and naming them here undoes that. Add them on the box as a
# drop-in, which survives package upgrades:
#
#   /etc/systemd/system/magicmirror.service.d/10-local-ordering.conf
#     [Unit]
#     Wants=<your unit>
#     After=<your unit>
#
# Soft ordering either way. The dashboard is useful on the LAN with both down,
# so nothing here should become a Requires= -- that would let a failed tunnel
# take the wall with it.

[Service]
Type=simple

User=calendar-display
Group=calendar-display

# Creates and owns /var/lib/magicmirror-secondbrain, where the module keeps the
# state that makes package tracking remember what it has already shown.
StateDirectory=magicmirror-secondbrain
StateDirectoryMode=0700

Environment=HOME=/home/calendar-display
Environment=NODE_ENV=production

# The server's timezone. The box itself is Etc/UTC; the kiosk's own timezone is
# separate and set in calendar-kiosk.
Environment=TZ=America/Denver

# Which node, and which MagicMirror tree. Both are settings rather than
# constants -- see the comment in secondbrain-server. The leading '-' means a
# box without the file still starts.
EnvironmentFile=-/etc/default/secondbrain
ExecStart=/usr/bin/secondbrain-server

Restart=on-failure
RestartSec=5s

[Install]
WantedBy=multi-user.target
