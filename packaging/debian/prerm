#!/bin/sh
set -e

MM_ROOT=/opt/MagicMirror
MODULES="MMM-SecondBrain NowPlaying FreezeWatch MMM-SolarTheme MMM-CalendarLiveHeader"

case "$1" in
    remove|deconfigure)
        systemctl --system stop magicmirror.service >/dev/null 2>&1 || true
        systemctl --system disable magicmirror.service >/dev/null 2>&1 || true

        # Only our own symlinks, and only if they still point at us. A module
        # someone later replaced with a real directory is theirs, not ours.
        for m in $MODULES; do
            if [ -L "$MM_ROOT/modules/$m" ]; then
                case "$(readlink "$MM_ROOT/modules/$m")" in
                    /usr/share/secondbrain/modules/*) rm -f "$MM_ROOT/modules/$m" ;;
                esac
            fi
        done
        ;;
esac

exit 0
