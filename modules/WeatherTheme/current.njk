{#
  Current conditions, numbers first.

  This is a themeDir for MagicMirror's stock weather module (see config.js:
  themeDir points here), so everything available to the stock current.njk is
  available here: `current` is a WeatherObject, `config` is the module config,
  and the filters are the module's own. Nothing is fetched; nothing is computed
  that the stock template does not also compute.

  The temperature is the biggest thing in the card because it is the one number
  people cross the room for. Everything else is a labelled value in a grid.
#}
{% if current %}
  <div class="wx">
    <div class="wx-primary">
      {# The degree sign is split out: at this size Rajdhani's ring is as tall as a digit. #}
      <div class="wx-temp">{{ current.temperature | roundValue | unit("temperature") | decimalSymbol | replace("°", "") }}<span class="wx-deg">°</span></div>
      <div class="wx-cond">
        {% if current.weatherType %}
          <span class="wi weathericon wi-{{ current.weatherType }}"></span>
        {% endif %}
        <span class="wx-cond-text">{{ current.weatherType | replace("sunny-overcast", "mostly cloudy") | replace("day-cloudy", "partly cloudy") | replace("night-alt-cloudy", "partly cloudy") | replace("night-alt-", "") | replace("day-", "") | replace("night-", "") | replace("sprinkle", "drizzle") | replace("rain-mix", "wintry mix") | replace("-", " ") }}</span>
      </div>
    </div>
    <div class="wx-metrics">
      {% if config.showFeelsLike %}
        <div class="wx-metric">
          <div class="wx-k">Feels</div>
          <div class="wx-v">{{ current.feelsLike() | roundValue | unit("temperature") | decimalSymbol }}</div>
        </div>
      {% endif %}
      {% if current.humidity %}
        <div class="wx-metric">
          <div class="wx-k">Humidity</div>
          <div class="wx-v">{{ current.humidity | roundValue | decimalSymbol }}%</div>
        </div>
      {% endif %}
      <div class="wx-metric">
        <div class="wx-k">Wind</div>
        {# MagicMirror's nunjucks trims around block tags, so the spaces are explicit. #}
        {% set windUnit = "m/s" %}
        {% if config.windUnits == "imperial" %}{% set windUnit = "mph" %}{% endif %}
        {% if config.windUnits == "kmh" %}{% set windUnit = "km/h" %}{% endif %}
        {% if config.windUnits == "knots" %}{% set windUnit = "kt" %}{% endif %}
        {% if config.windUnits == "beaufort" %}{% set windUnit = "bft" %}{% endif %}
        <div class="wx-v">{{ current.windSpeed | unit("wind") | round }} {{ windUnit }}{% if config.showWindDirection %} {{ current.cardinalWindDirection() | translate }}{% endif %}</div>
      </div>
      {% if config.showSun and current.sunrise and current.sunset %}
        <div class="wx-metric">
          <div class="wx-k">Sun</div>
          <div class="wx-v">{{ current.sunrise | formatTime }} <span class="wx-sep">/</span> {{ current.sunset | formatTime }}</div>
        </div>
      {% endif %}
    </div>
  </div>
{% else %}
  <div class="wx-loading">{{ "LOADING" | translate }}</div>
{% endif %}
